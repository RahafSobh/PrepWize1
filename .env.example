# PrepWize environment template — copy to `.env.local` for local development.
# Never commit real secrets. Production/staging values are set in your cloud dashboard.

# Logical environment: development | staging | production
APP_ENV=development

# HTTP server port (cloud platforms usually inject PORT automatically)
PORT=3000

# Node runtime mode: development (Vite HMR) or production (static dist/)
NODE_ENV=development

# Google Gemini API key — required for live AI (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Public app URL — used for logging and CORS (set per deploy environment)
APP_URL=http://localhost:3000

# Comma-separated allowed browser origins for CORS (optional for same-origin monolith)
# Example staging: https://prepwize-staging.onrender.com
ALLOWED_ORIGINS=
